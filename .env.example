# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real credentials.

# Discord bot token (from Discord Developer Portal → Your App → Bot → Token)
DISCORD_BOT_TOKEN=your-discord-bot-token-here

# Brave Search API key (https://api.search.brave.com — requires paid plan for News Search)
BRAVE_API_KEY=your-brave-search-api-key-here

# OpenClaw binary path for cron / non-interactive runs.
OPENCLAW_BIN=/home/natbanyat/.npm-global/bin/openclaw

# OpenClaw gateway-backed model routing.
# Leave unset by default so cron jobs use the gateway agent's allowed default model.
# Set only if the target model is allowlisted for the gateway agent.
# OPENCLAW_PIPELINE_MODEL=
# OPENCLAW_PIPELINE_DEEP_MODEL=
# OPENCLAW_PIPELINE_CHEAP_MODEL=
# OPENCLAW_PIPELINE_PRO_MODEL=

# Discord bot owner user ID — only this user's commands are processed by discord_bot.py
# Find it: Discord → Settings → Advanced → Developer Mode ON → right-click your name → Copy User ID
DISCORD_BOT_OWNER_ID=your-discord-user-id-here

# Finnhub API key (https://finnhub.io — free tier: 60 calls/min)
# Primary news source for US-listed tickers. Leave empty to use Brave only.
FINNHUB_API_KEY=

# X API v2 Bearer Token — OPTIONAL
# Requires X Developer account with at least Basic tier ($100/mo) for recent tweet search.
# Leave empty to skip X monitoring entirely.
X_BEARER_TOKEN=

# Comma-separated Discord user IDs allowed to satisfy transcript requests in #earnings-uploads.
# If empty, Discord manual transcript fallback is disabled.
EARNINGS_UPLOAD_ALLOWED_USER_IDS=

# Safety valve: when false/empty, transcripts sourced from Discord uploads will NOT auto-apply
# coverage changes; they will only generate proposals.
ALLOW_DISCORD_TRANSCRIPT_AUTO_APPLY=false

# ---------------------------------------------------------------------------
# Filings-scraper service (council_ui/official_docs_server.py, port 8876)
# ---------------------------------------------------------------------------

# Bearer token clients must present in `Authorization: Bearer <token>`.
# REQUIRED for any non-localhost bind (Tailscale, Cloudflare Tunnel, LAN).
# Generate with:  python -c 'import secrets; print(secrets.token_urlsafe(48))'
# Rotate by restarting the service with a new value.
FILINGS_SCRAPER_TOKEN=

# Base URL clients (skill, WSL CLI wrappers, future MBP) use to reach the
# service. Set to the value appropriate for THIS host:
#   Local Windows / openclaw WSL:  http://127.0.0.1:8876
#   MBP via Tailscale:             http://openclaw-wsl.tail-xxxx.ts.net:8876
#   Cloud Cowork via Tunnel:       https://filings.<your-domain>.com
FILINGS_SCRAPER_URL=http://127.0.0.1:8876

# Optional override of the corpus directory. Default is the WSL mount of the
# OneDrive folder; set this if the service runs from a different host.
# OFFICIAL_DOC_CORPUS_DIR=/mnt/c/Users/natba/OneDrive/@ Cowork/openclaw-investing-context

# Optional — reported by /version. Useful in packaged deploys where git isn't
# available. If unset, /version runs `git rev-parse --short HEAD`.
# FILINGS_SCRAPER_COMMIT_SHA=
